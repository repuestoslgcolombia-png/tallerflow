// TallerFlow - Sistema de Gestión de Talleres
// Prisma schema with domain entities

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============== USUARIOS Y TÉCNICOS ==============

// Tenant = taller. Cada taller aísla sus datos (multi-tenant real del SaaS).
model Tenant {
  id        String   @id @default(cuid())
  name      String // nombre del taller
  slug      String   @unique // URL-amigable: mi-taller
  plan      String   @default("early_access") // early_access | pro (fase 2 pagos)
  status    String   @default("active") // active | suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           TenantUser[]
  staffUsers      User[]
  customers       Customer[]
  devices         Device[]
  workOrders      WorkOrder[]
  parts           Part[]
  repairGuides    RepairGuide[]
  reminders       Reminder[]
  dailyTasks      DailyTask[]
  invoices        Invoice[]
  monthlyAccounting MonthlyAccounting[]
  settings        WorkshopSetting[]
  whatsappTemplates WhatsAppTemplate[]
  whatsappConnection WhatsAppConnection[]
  automations     AutomationRule[]
}

// Membresía usuario↔taller con rol (el user.id es el uuid de Supabase Auth)
model TenantUser {
  id        String   @id @default(cuid())
  userId    String // Supabase auth.users.id (uuid)
  tenantId  String
  role      String   @default("owner") // owner | admin | technician | receptionist
  status    String   @default("active") // active | invited
  email     String? // email de invitación (antes de aceptar)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Relación "loose": userId referencia auth.users de Supabase (fuera de Prisma), sin FK física.
  // Se valida en app-layer: requireTenantSession() resuelve membresía activa.

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  name      String
  role      String   @default("admin") // admin | technician | receptionist
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  workOrders WorkOrder[] @relation("AssignedTechnician")
  diagnoses  Diagnosis[] @relation("DiagnosisAuthor")
  auditLogs  AuditLog[]
  dailyTasks DailyTask[]
  repairGuides RepairGuide[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ============== CLIENTES ==============

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  firstName   String
  lastName    String
  documentId  String? // Cédula/RUT/DNI
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices    Device[]
  workOrders WorkOrder[]
  invoices   Invoice[]
  reminders  Reminder[]
  messages   WhatsAppMessage[]
  portalTokens PortalToken[]
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@index([lastName])
  @@index([tenantId])
}

// ============== EQUIPOS / DISPOSITIVOS ==============

model Device {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  type        String // washing_machine | refrigerator | freezer | gas_dryer | air_conditioner | tv | microwave | oven | stove | water_heater | other
  brand       String?
  model       String?
  serial      String?
  accessories String? // accesorios entregados
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]
  tenant     Tenant     @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

// ============== ÓRDENES DE TRABAJO ==============

model WorkOrder {
  id              String   @id @default(cuid())
  tenantId        String
  code            String // OT-2024-001 (único POR TALLER)
  customerId      String
  deviceId        String
  technicianId    String?
  status          String   @default("received") // received | diagnosing | quoted | approved | in_progress | ready | delivered | cancelled
  priority        String   @default("normal") // low | normal | high | urgent
  serviceType     String   @default("revision") // mantenimiento | revision | instalacion
  scheduledVisitAt DateTime? // fecha y hora de visita técnica
  reportedIssue   String // problema reportado por el cliente
  diagnosisText   String?
  internalNotes   String?
  receivedAt      DateTime @default(now())
  estimatedDoneAt DateTime?
  deliveredAt     DateTime?
  totalAmount     Float    @default(0)
  totalPaid       Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer    Customer    @relation(fields: [customerId], references: [id])
  device      Device      @relation(fields: [deviceId], references: [id])
  technician  User?       @relation("AssignedTechnician", fields: [technicianId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  timeline    WorkOrderEvent[]
  quotes      Quote[]
  invoice     Invoice?
  partsUsed   InventoryMovement[]
  diagnosis   Diagnosis?
  reminders   Reminder[]
  messages    WhatsAppMessage[]
  repairGuides RepairGuide[]

  @@index([customerId])
  @@index([deviceId])
  @@index([technicianId])
  @@index([status])
  @@index([tenantId])
  @@index([tenantId, status])
  @@unique([tenantId, code])
}

model WorkOrderEvent {
  id          String   @id @default(cuid())
  workOrderId String
  eventType   String // status_change | note | assignment | diagnosis_update
  fromStatus  String?
  toStatus    String?
  title       String
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// ============== DIAGNÓSTICO Y COTIZACIÓN ==============

model Diagnosis {
  id           String   @id @default(cuid())
  workOrderId  String   @unique
  authorId     String
  findings     String // hallazgos técnicos
  rootCause    String? // causa raíz
  recommendation String? // recomendación
  laborHours   Float    @default(0)
  laborCost    Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User      @relation("DiagnosisAuthor", fields: [authorId], references: [id])
}

model Quote {
  id           String   @id @default(cuid())
  tenantId     String
  workOrderId  String
  code         String // COT-2024-001 (único POR TALLER)
  status       String   @default("draft") // draft | sent | approved | rejected | expired
  approvalToken String  @unique
  notes        String?
  validUntil   DateTime?
  subtotal     Float    @default(0)
  tax          Float    @default(0)
  taxRate      Float    @default(0) // porcentaje de IVA aplicado
  total        Float    @default(0)
  sentAt       DateTime?
  viewedAt     DateTime?
  approvedAt   DateTime?
  approvedBy   String? // nombre de quien aprueba
  rejectionReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workOrder WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  items     QuoteItem[]
  events    QuoteEvent[]

  @@index([workOrderId])
  @@index([status])
  @@index([tenantId])
  @@unique([tenantId, code])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  itemType    String // part | labor | other
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  partId      String?
  createdAt   DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  part  Part?  @relation(fields: [partId], references: [id])

  @@index([quoteId])
}

model QuoteEvent {
  id          String   @id @default(cuid())
  quoteId     String
  eventType   String // created | sent | viewed | approved | rejected | expired | resent | edited
  fromStatus  String?
  toStatus    String?
  title       String
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

// ============== INVENTARIO ==============

model Part {
  id               String   @id @default(cuid())
  tenantId         String
  sku              String // único POR TALLER
  name             String
  description      String?
  category         String? // washing_machine | refrigerator | freezer | gas_dryer | air_conditioner | tv | refrigeration | tools | other
  applianceType    String? // tipo de electrodoméstico compatible (lavadora, nevera, etc.)
  brand            String? // marca del repuesto (LG, Samsung, Whirlpool, universal)
  compatibleBrands String? // marcas compatibles (JSON: ["LG","Samsung"])
  model            String? // modelo específico o "universal"
  voltage          String? // voltaje (110V, 220V, N/A)
  powerWatts       String? // potencia en watts (ej: "1500W")
  gasType          String? // tipo de gas (R134a, R410A, R22, N/A)
  dimensions       String? // dimensiones físicas
  warranty         Int?     // meses de garantía
  unit             String   @default("unidad") // unidad | metro | gramo | litro
  stock            Int      @default(0)
  minStock         Int      @default(0)
  unitCost         Float    @default(0)
  unitPrice        Float    @default(0)
  location         String? // ubicación física
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  movements        InventoryMovement[]
  quoteItems       QuoteItem[]
  tenant           Tenant @relation(fields: [tenantId], references: [id])

  @@index([category])
  @@index([name])
  @@index([brand])
  @@index([tenantId])
  @@unique([tenantId, sku])
}

model InventoryMovement {
  id           String   @id @default(cuid())
  partId       String
  workOrderId  String?
  movementType String // in | out | adjustment
  quantity     Int
  reason       String?
  unitCost     Float    @default(0)
  createdAt    DateTime @default(now())
  createdBy    String?

  part      Part      @relation(fields: [partId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([partId])
  @@index([workOrderId])
}

// ============== BASE DE CONOCIMIENTO DE REPARACIONES ==============

model RepairGuide {
  id               String   @id @default(cuid())
  tenantId         String
  title            String
  summary          String?
  applianceType    String // reutiliza keys de DEVICE_TYPES (washing_machine, refrigerator, ...)
  brand            String?
  model            String?
  symptoms         String? // JSON array: ["No desagua", "Hace ruido"]
  steps            String // procedimiento de reparación (texto plano)
  difficulty       String   @default("media") // facil | media | compleja
  estimatedHours   Float    @default(0)
  partsUsed        String? // JSON array: [{partId?, name, qty}]
  status           String   @default("draft") // draft | active | retired
  version          Int      @default(1)
  usageCount       Int      @default(0)
  authorId         String
  sourceWorkOrderId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  author         User      @relation(fields: [authorId], references: [id])
  sourceWorkOrder WorkOrder? @relation(fields: [sourceWorkOrderId], references: [id])
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@index([applianceType])
  @@index([brand, model])
  @@index([status])
  @@index([authorId])
  @@index([sourceWorkOrderId])
  @@index([tenantId])
}

// ============== FACTURACIÓN ==============

model Invoice {
  id           String   @id @default(cuid())
  tenantId     String
  code         String // FAC-2024-001 (único POR TALLER)
  workOrderId  String   @unique
  customerId   String
  subtotal     Float    @default(0)
  tax          Float    @default(0)
  taxRate      Float    @default(0) // porcentaje de IVA aplicado
  total        Float    @default(0)
  paid         Float    @default(0)
  paymentMethod String? // cash | card | transfer
  status       String   @default("pending") // pending | paid | partial | cancelled
  issuedAt     DateTime @default(now())
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@index([customerId])
  @@index([tenantId])
  @@unique([tenantId, code])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  itemType    String   @default("other") // part | labor | other
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ============== LIBRO DE PAGOS (contabilidad) ==============

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String   @default("cash") // cash | card | transfer
  notes     String?
  paidAt    DateTime @default(now())
  createdBy String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paidAt])
}

// ============== CONTABILIDAD MENSUAL ==============

model MonthlyAccounting {
  id          String    @id @default(cuid())
  tenantId    String
  year        Int
  month       Int // 1-12
  invoiced    Float     @default(0)
  collected   Float     @default(0)
  outstanding Float     @default(0)
  expenses    Float     @default(0)
  profit      Float     @default(0)
  status      String    @default("open") // open | closed
  closedAt    DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, year, month])
}

// ============== RECORDATORIOS POST-SERVICIO ==============

model Reminder {
  id           String   @id @default(cuid())
  tenantId     String
  customerId   String
  workOrderId  String?
  type         String   @default("follow_up") // follow_up | warranty_check | service_review | maintenance | custom
  title        String
  message      String?  // mensaje plantilla o personalizado
  dueDate      DateTime // fecha programada del recordatorio
  channel      String   @default("whatsapp") // whatsapp | email | phone | sms
  status       String   @default("pending") // pending | sent | done | snoozed | cancelled
  priority     String   @default("normal") // low | normal | high
  daysAfter    Int?     // días después del servicio (para auto-cálculo)
  completedAt  DateTime?
  completedBy  String?
  completionNotes String? // resultado del contacto
  snoozedUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])
  whatsApp  WhatsAppMessage?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([workOrderId])
  @@index([status, dueDate])
  @@index([tenantId])
}

// ============== TAREAS DIARIAS / CHECKLIST ==============

model DailyTask {
  id             String    @id @default(cuid())
  tenantId       String
  title          String
  description    String?
  assigneeId     String?
  taskDate       DateTime  // día específico (se usa solo la fecha sin hora)
  priority       String    @default("normal") // low | normal | high
  isRecurring    Boolean   @default(false)
  recurringRule  String?   // daily | weekly | monthly | weekday
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  completedBy    String?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignee User? @relation(fields: [assigneeId], references: [id])
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([taskDate])
  @@index([assigneeId])
  @@index([isCompleted, taskDate])
  @@index([tenantId])
}

// ============== MENSAJES WHATSAPP ==============

model WhatsAppConnection {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  phone         String?  // número de WhatsApp Business enlazado
  displayName   String?  // nombre visible del negocio
  status        String   @default("disconnected") // disconnected | pairing | connected
  pairingCode   String?  // código de emparejamiento (6 dígitos)
  qrToken       String?  // token único del QR
  qrExpiresAt   DateTime?
  connectedAt   DateTime?
  lastSeenAt    DateTime?
  businessName  String?  // nombre del taller
  apiKey        String?  // para futura integración con Cloud API
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model WhatsAppTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  code        String // quote_sent | order_ready | follow_up | etc. (único POR TALLER)
  name        String
  category    String   @default("general") // general | quotes | orders | reminders | marketing
  subject     String?  // asunto corto para referencia
  body        String   // cuerpo del mensaje con variables {cliente}, {equipo}, etc.
  active      Boolean  @default(true)
  isSystem    Boolean  @default(false) // true = plantilla del sistema (no editable)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages WhatsAppMessage[]
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([category])
  @@index([active])
  @@index([tenantId])
  @@unique([tenantId, code])
}

model WhatsAppMessage {
  id           String   @id @default(cuid())
  customerId   String?
  workOrderId  String?
  reminderId   String? @unique
  templateId   String?
  toPhone      String   // número de destino
  toName       String?  // nombre del destinatario
  message      String   // mensaje final enviado
  status       String   @default("sent") // sent | failed | pending
  channel      String   @default("whatsapp") // whatsapp | email
  sentAt       DateTime @default(now())
  sentBy       String?  // usuario que envió
  createdAt    DateTime @default(now())

  customer  Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrder WorkOrder?        @relation(fields: [workOrderId], references: [id])
  reminder  Reminder?         @relation(fields: [reminderId], references: [id])
  template  WhatsAppTemplate? @relation(fields: [templateId], references: [id])

  @@index([customerId])
  @@index([workOrderId])
  @@index([sentAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String // create | update | delete | status_change
  entity      String // WorkOrder | Customer | Device | ...
  entityId    String
  description String?
  metadata    String? // JSON serializado
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
}

// ============== AUTOMATIZACIONES WHATSAPP ==============

model AutomationRule {
  id           String   @id @default(cuid())
  tenantId     String
  trigger      String // order_received | quote_sent | quote_approved | order_ready | order_delivered | payment_received | invoice_created
  action       String   @default("send_whatsapp") // send_whatsapp | create_reminder
  enabled      Boolean  @default(true)
  templateCode String?  // código de la plantilla de WhatsApp a usar
  delayMinutes Int      @default(0) // minutos de espera antes de enviar (0 = inmediato, solo send_whatsapp)
  daysOffset   Int?     // días después del evento para crear el recordatorio (solo create_reminder)
  reminderType String?  // warranty_check | maintenance (solo create_reminder)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, trigger, action])
}

model AutomationLog {
  id          String   @id @default(cuid())
  ruleId      String?
  workOrderId String?
  customerId  String?
  trigger     String   // qué evento lo disparó
  phone       String   // número al que se envió
  message     String   // mensaje enviado
  status      String   @default("sent") // sent | failed | skipped
  error       String?  // mensaje de error si falló
  sentAt      DateTime @default(now())

  @@index([workOrderId])
  @@index([customerId])
  @@index([sentAt])
}

// ============== CONFIGURACIÓN DEL TALLER ==============

model WorkshopSetting {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  name          String  @default("TallerFlow Demo")
  phone         String?
  email         String?
  address       String?
  taxRate       Float    @default(19) // porcentaje de impuesto
  currency      String   @default("COP")
  currencySymbol String  @default("$")
  logoUrl       String?
  warrantyPolicy String?
  counterWorkOrder Int   @default(0)
  counterQuote  Int      @default(0)
  counterInvoice Int     @default(0)
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// ============== PORTAL DEL CLIENTE ==============

model PortalToken {
  id          String   @id @default(cuid())
  customerId  String
  token       String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  lastAccessAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}
