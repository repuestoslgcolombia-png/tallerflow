# TallerFlow — variables de entorno (plantilla)
# Copia a .env.local y completa los valores. NUNCA commitear .env* con valores reales.

# Base de datos (Neon Postgres) — OBLIGATORIAS
DATABASE_URL=postgresql://usuario:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://usuario:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Redis (Upstash) — pendientes de Hermes + rate limiting
REDIS_URL=rediss://default:password@xxx.upstash.io:6379

# Supabase (auth) — OBLIGATORIAS
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Asistente IA (Hermes)
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=deepseek/deepseek-chat
AI_GROQ_API_KEY=
